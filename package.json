{
  "name": "nest-starter",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build --builder swc",
    "auth:migrate": "bun scripts/migrate-database.ts",
    "db:migrate": "bun scripts/migrate-database.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc",
    "start:debug": "nest start --debug --watch --builder swc",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/sso": "1.5.6",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@thallesp/nestjs-better-auth": "^2.5.3",
    "better-auth": "1.5.6",
    "kysely": "^0.28.15",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.1.6",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.5.2",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.2"
  }
}
